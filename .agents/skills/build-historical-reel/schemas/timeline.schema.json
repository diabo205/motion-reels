{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoricalReelTimeline",
  "type": "object",
  "required": ["meta", "scenes"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["title", "flagEmoji", "fps", "width", "height", "bpm"],
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "flagEmoji": { "type": "string" },
        "fps": { "type": "integer", "enum": [60] },
        "width": { "type": "integer", "enum": [1080] },
        "height": { "type": "integer", "enum": [1920] },
        "bpm": { "type": "number", "minimum": 60, "maximum": 200 },
        "bgmFile": { "type": "string" },
        "bgmStartFrom": { "type": "number" },
        "bgmLicense": {
          "type": "object",
          "required": ["source", "licenseType", "clearanceId"],
          "properties": {
            "source": { "type": "string" },
            "licenseType": {
              "type": "string",
              "enum": ["ROYALTY_FREE", "PUBLIC_DOMAIN", "ORIGINAL_SYNTH", "CREATIVE_COMMONS", "LICENSED_COMMERCIAL"]
            },
            "clearanceId": { "type": "string" },
            "attribution": { "type": "string" }
          }
        },
        "palette": {
          "type": "string",
          "enum": ["POLAR_MARITIME", "CONFLICT_CRISIS", "ESPIONAGE_DOSSIER"]
        },
        "particleEmitter": {
          "type": "string",
          "enum": ["SNOW", "ASH", "RAIN", "DUST", "NONE"]
        },
        "fontFamily": {
          "type": "string",
          "enum": ["Montserrat", "Inter"]
        },
        "styleMode": {
          "type": "string",
          "enum": ["DOCUMENTARY_SANS", "TACTILE_TORN_PAPER"]
        },
        "safeZoneProfile": {
          "type": "string",
          "enum": ["CONSERVATIVE_UNION", "YOUTUBE_SHORTS", "TIKTOK", "INSTAGRAM_REELS"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["STANDARD", "SOMBER_MEMORIAL", "HIGH_SENSITIVITY"]
        },
        "loopSeamless": { "type": "boolean" },
        "ctaConfig": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "subtext": { "type": "string" }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 29,
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "startFrame",
          "durationFrames",
          "archetype",
          "hudVisible",
          "camera",
          "textLayers",
          "visualPayload"
        ],
        "properties": {
          "sceneId": { "type": ["string", "integer"] },
          "startFrame": { "type": "integer", "minimum": 0, "maximum": 3500 },
          "durationFrames": { "type": "integer", "minimum": 84, "maximum": 250 },
          "archetype": {
            "type": "string",
            "enum": [
              "LONE_LEADER",
              "CROWD_TALLY",
              "VEHICLE_IN_TRANSIT",
              "STRUCTURAL_FRACTURE",
              "VECTOR_MAP",
              "SPLIT_CONFRONTATION",
              "QUOTE_CARD",
              "SILHOUETTE_ACTION",
              "FLAG_BANNER",
              "TACTICAL_MAP",
              "DOCUMENT_CARD",
              "BLUEPRINT_DIAGRAM",
              "TELEMETRY_COUNTER",
              "SPOTLIGHT_EMBLEM"
            ]
          },
          "hudVisible": { "type": "boolean" },
          "headerContext": { "type": "string" },
          "sensitivity": {
            "type": "string",
            "enum": ["STANDARD", "SOMBER_MEMORIAL", "HIGH_SENSITIVITY"]
          },
          "claim": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "source": { "type": "string" },
              "url": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          },
          "camera": {
            "type": "object",
            "required": ["movement", "intensity"],
            "properties": {
              "movement": {
                "type": "string",
                "enum": [
                  "STATIC",
                  "SLOW_PUSH_IN",
                  "PARALLAX_PAN_RIGHT",
                  "CRANE_SWEEP_UP",
                  "DUTCH_TILT",
                  "IMPACT_SHAKE"
                ]
              },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1.5 }
            }
          },
          "transientType": {
            "type": "string",
            "enum": ["BASS_DROP", "CYMBAL_CRASH", "ENERGY_PEAK", "BEAT_ONSET", "BAR_BOUNDARY", "TEMPO_GRID"]
          },
          "transientHitFrame": { "type": "integer" },
          "structuralFractureHitFrame": { "type": "integer" },
          "textLayers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["text", "triggerFrameOffset", "tier", "colorToken", "animation"],
              "properties": {
                "text": { "type": "string" },
                "triggerFrameOffset": { "type": "integer", "minimum": 0 },
                "tier": {
                  "type": "string",
                  "enum": ["DISPLAY_HERO", "PRIMARY_STATEMENT", "SECONDARY_ACCENT", "SUB_CAPTION"]
                },
                "colorToken": {
                  "type": "string",
                  "enum": ["PURE_WHITE", "ALERT_RED", "MEDAL_GOLD", "TACTICAL_CYAN", "MUTED_CREAM", "STARK_WHITE"]
                },
                "animation": {
                  "type": "string",
                  "enum": ["HARD_POP", "SCALE_SLAM", "TYPEWRITER", "STAMP_THUD", "BLUR_TO_SHARP", "SLOW_REVEAL"]
                },
                "handwrittenNote": { "type": "string" },
                "rollingCounter": { "type": "boolean" }
              }
            }
          },
          "visualPayload": {
            "type": "object",
            "required": ["svgForegroundAsset"],
            "properties": {
              "skyGradient": {
                "type": "array",
                "items": { "type": "string" }
              },
              "stageStyle": {
                "type": "string",
                "enum": [
                  "PAPER_EXTERIOR",
                  "GRAPH_GRID",
                  "SUNBURST_HERO",
                  "NIGHT_FELT",
                  "WOOD_PANEL",
                  "LOCKED_CANVAS"
                ]
              },
              "svgForegroundAsset": { "type": "string" },
              "archetypeVariant": { "type": "string" },
              "quoteAttribution": { "type": "string" },
              "atmosphericPlatePrompt": { "type": "string" },
              "counterConfig": {
                "type": "object",
                "required": ["label", "startValue", "endValue"],
                "properties": {
                  "label": { "type": "string" },
                  "startValue": { "type": "number" },
                  "endValue": { "type": "number" }
                }
              }
            }
          },
          "sfxTriggers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sfxFile", "frameOffset"],
              "properties": {
                "sfxFile": { "type": "string" },
                "frameOffset": { "type": "integer", "minimum": 0 },
                "leadFrames": { "type": "integer", "minimum": 0, "maximum": 10 }
              }
            }
          }
        }
      }
    }
  }
}
